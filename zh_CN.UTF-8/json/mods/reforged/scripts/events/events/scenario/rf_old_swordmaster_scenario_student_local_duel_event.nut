    "translation": "巅峰对决！",
    "stage": 1,
    "context": "_event.m.Title = \"The duel!\""
  },
  {
    "ID": 1007440846,
    "key": "16a628e31569ec0166a65ef8769662c31d6af8212473a1a1ccaaaecf5e06ff5e",
    "original": "Won a great duel",
