  },
  {
    "ID": 1007440843,
    "key": "eb293d577c62e7806daa830ded3d3fedab134b43d97016a3570f11b1d9e35a94",
    "original": "The company gained renown",
    "translation": "战团获得了名望",
    "stage": 1,
    "context": "text = \"The company gained renown\""
  },
  {
    "ID": 1007440844,
    "key": "d6fa6517e28fd7d69c110cb4d02fb2fc6cb146d36a9058dfbcae12d22396f243",
    "original": "The company's champion won an impressive duel",
    "translation": "战团的勇士在一场意义非凡的对决中胜出",
    "context": "bro.improveMood(0.5, \"The company's champion won an impressive duel\")"
  },
  {
