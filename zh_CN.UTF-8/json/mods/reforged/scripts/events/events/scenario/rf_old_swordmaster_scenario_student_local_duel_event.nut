  },
  {
    "ID": 1007440832,
    "key": "93960502607a49f9c21e55e07d54d0bb3c6a390089ac56b8587c856919cdbb84",
    "original": "Farewell %champion%! You died too young!",
    "translation": "永别了，%champion%！怎奈你英年早逝！",
    "context": "Text = \"Farewell %champion%! You died too young!\""
  },
  {
    "ID": 1007440833,
    "key": "5a070c113dc7bfca8fd060db7fb94535399ed0e2b2a43c94d15d9bfa44729650",
    "original": "Go with my blessing, %champion%!",
    "translation": "我会为你祈祷的，%champion%！",
    "context": "Text = \"Go with my blessing, %champion%!\""
  },
  {
    "ID": 1007440834,
    "key": "853d0afd9c941f2ab62cd22ac74c341b0a2463184d18904870b796628f313cfc",
    "original": "Good luck!",
    "translation": "祝你好运！",
    "context": "Text = \"Good luck!\""
  },
  {
    "ID": 1007440835,
    "key": "001f2849117b98a5c2ccf20a52c8d54a4c816df2ddc13fae49e58c56b4bd8dfb",
    "original": "I am proud of you, %champion%!",
    "translation": "%champion%，你是我的骄傲！",
    "context": "Text = \"I am proud of you, %champion%!\""
  },
  {
    "ID": 1007440836,
    "key": "df4d6d66df1319462e7d4160135059dd1ea157d2ca89ec6844f934ce0003d4db",
    "original": "I need you to avenge us, ",
    "translation": "你来代表我们报仇",
    "stage": 1,
    "context": "\"I need you to avenge us, \" + bro.getName() + \".\""
  },
  {
    "ID": 1007440837,
    "key": "fd594d6f5ad74773e918177fa65420dac2e55180c761faa9f3946032cbc77b23",
    "original": "Make me proud, ",
    "translation": "让我骄傲吧，",
    "stage": 1,
    "context": "\"Make me proud, \" + _event.m.Champion.getName() + \"!\""
  },
  {
