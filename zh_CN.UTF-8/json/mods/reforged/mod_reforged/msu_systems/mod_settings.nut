  },
  {
    "ID": 1007440565,
    "key": "36706287360c6e76722c03e87251a2ed242d6fdf379bad9a01469055fa02a155",
    "original": "Show all the usable active skills for entities in the Tactical Tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addEnumSetting(\"TacticalTooltip_ActiveSkills\", \"All\", [\"All\",\"AI Only\",\"Player Only\",\"None\"], \"Show Active Skills\", \"Show all the usable active skills for entities in the Tactical Tooltip.\")"
  },
  {
    "ID": 1007440566,
    "key": "ea7d671734fb872311d6981cf852686a2235fbec8b6b5a463e34568a6f736c80",
    "original": "Show attributes such as Melee Skill, Melee Defense etc. for entities in the Tactical Tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addEnumSetting(\"TacticalTooltip_Attributes\", \"All\", [\"All\",\"AI Only\",\"Player Only\",\"None\"], \"Show Attributes\", \"Show attributes such as Melee Skill, Melee Defense etc. for entities in the Tactical Tooltip.\")"
  },
  {
    "ID": 1007440567,
    "key": "74854eba554a9335225bfa49e24829e3a811cde131b849ae0c0a5ea86902ecbc",
    "original": "Show equipped items for entities in the Tactical Tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addEnumSetting(\"TacticalTooltip_EquippedItems\", \"All\", [\"All\",\"AI Only\",\"Player Only\",\"None\"], \"Show Equipped Items\", \"Show equipped items for entities in the Tactical Tooltip.\")"
  },
  {
    "ID": 1007440568,
    "key": "f5470e041b7eb35d1c218a5f594894b58226ccd5d3497d0c0daa7ddc906d5d21",
    "original": "Show items in bag for entities in the Tactical Tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addEnumSetting(\"TacticalTooltip_BagItems\", \"All\", [\"All\",\"AI Only\",\"Player Only\",\"None\"], \"Show Bag Items\", \"Show items in bag for entities in the Tactical Tooltip.\")"
  },
  {
    "ID": 1007440569,
    "key": "48577d1b59b9430b726a6b6505a9ef1ba3747984c95390f76210c10112282360",
    "original": "Show perks for entities in the Tactical Tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addEnumSetting(\"TacticalTooltip_Perks\", \"All\", [\"All\",\"AI Only\",\"Player Only\",\"None\"], \"Show Perks\", \"Show perks for entities in the Tactical Tooltip.\")"
  },
  {
    "ID": 1007440570,
    "key": "89591b77eda136504628252ea1b9da26e9ec233bc91de9e15970642f998d3e7d",
    "original": "Show status effects for entities in the Tactical Tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addEnumSetting(\"TacticalTooltip_Effects\", \"All\", [\"All\",\"AI Only\",\"Player Only\",\"None\"], \"Show Effects\", \"Show status effects for entities in the Tactical Tooltip.\")"
  },
  {
    "ID": 1007440571,
    "key": "9e2b6b8103afe39babaff64aa54bafa91542e40023a8dc9829f74003ffb07b5f",
    "original": "Skip Contracts To",
    "translation": ""
  },
  {
    "ID": 1007440572,
    "key": "3f896208caca283749e09a97c5af97bda0281bd1c50d8fd79995dbf06ad22f89",
    "original": "Some Perks are also Status Effects. Usually their Effect is hidden until some condition is fulfilled. When this setting is enabled, these perks show up in the Perks category even when they show up under Effects (e.g. when their effect is active). When disabled, when they appear under Effects, they will be hidden from the Perks category. This can help save space on the tooltip.",
    "translation": "",
    "context": "tacticalTooltipPage.addBooleanSetting(\"ShowStatusPerkAndEffect\", True, \"Show Status Perk And Effect\", \"Some Perks are also Status Effects. Usually their Effect is hidden until some condition is fulfilled. When this setting is enabled, these perks show up in the Perks category even when they show up under Effects (e.g. when their effect is active). When disabled, when they appear under Effects, they will be hidden from the Perks category. This can help save space on the tooltip.\")"
  },
  {
    "ID": 1007440573,
    "key": "8d65d460b6ff328615c1a3775e2993227894900fc1c3f2d868fa7f7e5f6de501",
    "original": "Spawns Info",
    "translation": "",
    "context": "debugPage.addBooleanSetting(\"Dev_SpawnsInfo\", False, \"Spawns Info\", \"Enable display of various information about spawns on the world map such as party cost/strength, spawn day etc.\")"
  },
  {
    "ID": 1007440574,
    "key": "7e9412bf0a1042e7a880d2b352f448711ab737e6cd02886c742dc8678ae0bcc1",
    "original": "Toggle Reforged Dev Mode",
    "translation": ""
  },
  {
    "ID": 1007440575,
    "key": "1cfb0bd9a2d1c43a547764ca150a58376269c573cc38d3478bf67698b7ddae83",
    "original": "Tooltips",
    "translation": ""
  },
  {
    "ID": 1007440576,
    "key": "bcf94bd2edc55910c6a02bcdb77ca903abfe420ab6361c8b5f1308d66d09dc79",
    "original": "Used to toggle Dev mode for Reforged. This enables/disables the various Dev mode settings all at once.",
    "translation": ""
  },
  {
    "ID": 1007440577,
    "key": "d20357b8d5763f4ecd13efd267335a23a81ae1f68b263de0bbaf51705cc3d61b",
    "original": "Used to toggle the confirmation requirement for skills that are normally used immediately (e.g. Shieldwall, Rally). It allows you to either preview the Action Point and Fatigue costs or bypass confirmation, depending on your 'Confirm Skill Use' setting.",
    "translation": "",
    "context": "getroottable().Reforged.Mod.Keybinds.addSQKeybind(\"ConfirmSkillUseKeybind\", \"ctrl\", getroottable().MSU.Key.State.Tactical, function None(){\n    return True;;\n    return;\n}, \"Confirm Skill Use\", null, \"Used to toggle the confirmation requirement for skills that are normally used immediately (e.g. Shieldwall, Rally). It allows you to either preview the Action Point and Fatigue costs or bypass confirmation, depending on your 'Confirm Skill Use' setting.\")"
  },
  {
    "ID": 1007440578,
    "key": "05dcae2b47ae8627c7efc7039efad0130b750e598ada60408ca22bebd74d1e1f",
    "original": "Vanilla",
    "translation": "",
    "context": "miscTooltipPage.addEnumSetting(\"CraftingBlueprintVisibility\", \"One Ingredient Available\", [\"Always\",\"One Ingredient Available\",\"All Ingredients Available\",\"Vanilla\"], \"Blueprints Visible When\", \"Crafting Recipes in the Taxidermist will be displayed when this condition is met.\nNote that individual Blueprints (like Snake Oil) may still have custom rules preventing them from being shown.\n\n'Vanilla' means that the visibility behavior is unchanged from how it works in the base game.\")"
  },
  {
    "ID": 1007440579,
    "key": "0e818dbc8410aeaef017393b2d4bffd1ede3076f7aeb4df4eccc135a292966ae",
    "original": "Wait Turn with all Characters",
    "translation": "",
    "context": "getroottable().Reforged.Mod.Keybinds.addSQKeybind(\"Tactical_WaitRound\", \"h\", getroottable().MSU.Key.State.Tactical, function None(){\n    if (this.m.MenuStack.hasBacksteps() || this.isInputLocked() || this.isInCharacterScreen()) {\n        return False;\n    } else {\n        getroottable().Tactical.TurnSequenceBar.RF_onWaitTurnAllButtonPressed();\n        return True;\n    };\n    return;\n}, \"Wait Turn with all Characters\")"
  },
  {
    "ID": 1007440580,
    "key": "6286f503d28eeac1a7dfecda762473d280e8615f2f18bdd0c048e8c233c0fd7e",
    "original": "When clicking on contracts in settlements, auto-negotiate them this many times for more payment. This process will stop as soon as the employer rejects a negotiation attempt (i.e. did not increase his offer), or the negotiations fail.",
    "translation": ""
  },
  {
    "ID": 1007440581,
    "key": "b865e7183f6c0943501e5fc4525d77460b788282a4c3d02a3b170e78411e8ff8",
    "original": "When this condition is met, the minimum and maximum Base Attribute Ranges for backgrounds are displayed, when looking at their tooltips. 'Only New Recruits' stops displaying the info, once you have spent one level-up.",
    "translation": "",
    "context": "characterScreenPage.addEnumSetting(\"CharacterScreen_ShowBaseAttributeRangesRegular\", \"Only New Recruits\", [\"Always\",\"Only New Recruits\",\"Never\"], \"Show Base Attribute Ranges (Regular)\", \"When this condition is met, the minimum and maximum Base Attribute Ranges for backgrounds are displayed, when looking at their tooltips. 'Only New Recruits' stops displaying the info, once you have spent one level-up.\")"
  },
  {
    "ID": 1007440582,
    "key": "7e88a1703580edb8812239d3e9b48999f6729aac2ae6da7ec9c2af6da63c2106",
    "original": "While the number of active skills is below this value they display their icon and use a separate line. Otherwise they combine into a single block of text in order to save space.",
    "translation": "",
    "context": "tacticalTooltipPage.addRangeSetting(\"CollapseActivesWhenX\", 5, 0, 20, 1, \"Collapse Actives When\", \"While the number of active skills is below this value they display their icon and use a separate line. Otherwise they combine into a single block of text in order to save space.\")"
  },
  {
    "ID": 1007440583,
    "key": "eb58649727a4d00b7cb6dc3dc7cc09ba0af353443f2226b098c449c9d5bfca6f",
    "original": "While the number of effects is below this value all effects display their icon and use a separate line. Otherwise they combine into a single block of text in order to save space.",
    "translation": "",
    "context": "tacticalTooltipPage.addRangeSetting(\"CollapseEffectsWhenX\", 5, 0, 20, 1, \"Collapse Effects When\", \"While the number of effects is below this value all effects display their icon and use a separate line. Otherwise they combine into a single block of text in order to save space.\")"
  },
  {
    "ID": 1007440584,
    "key": "137a3e82aefc9eb97a4ac21b7cbc9fb9dd728c4c495e61fe63f6254199862fc9",
    "original": "While the number of perks is below this value all perks display their icon and use a separate line. Otherwise they combine into a single block of text in order to save space.",
    "translation": "",
    "context": "tacticalTooltipPage.addRangeSetting(\"CollapsePerksWhenX\", 5, 0, 20, 1, \"Collapse Perks When\", \"While the number of perks is below this value all perks display their icon and use a separate line. Otherwise they combine into a single block of text in order to save space.\")"
  },
  {
