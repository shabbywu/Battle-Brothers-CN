  {
    "key": "b247c7ad8d2a6b2236c6f5b1c7299d463991935c9cd9c98d5eac2eaccdcc6dd0",
    "original": "During movement preview, opponents with predicted hitchance equal to this or less are collapsed into a single tooltip entry.",
    "translation": "",
    "context": ""
  },
  {
    "key": "632d94c6c579d80fbe700c8a48b7e106a0ada18f12f82678f3e8e30cee910656",
    "original": "During movement preview, show predicted chance to hit and to be hit based on the hovered tile.",
    "translation": "",
    "context": ""
  },
  {
    "key": "26f0663bde205c930ad83863c2082dd5a2c12f66b598d4eb7d707f9e4db1c5d2",
    "original": "Enable display of various information about spawns on the world map such as party cost/strength, spawn day etc.",
    "translation": "",
    "context": ""
  },
  {
    "key": "e43ccb60134b5b7bd47409f0a1bcf8253788bfb8c2d070f7396a0feaf3bb3a3c",
