    "translation": "",
    "context": ""
  },
  {
    "key": "1c0f12dae3a04075c1c481c9b7f799538d9cb7baf606549f460cdaf4e7952bbc",
    "original": "The Longrest Fane",
    "translation": "",
    "context": ""
  },
  {
    "key": "65b6ea8092e0d81d2150f820d106e99c38ab18c11c655c9899f14692c2ccfd1d",
    "original": "The Low Cairn",
    "translation": "",
    "context": ""
  },
  {
    "key": "b8c06bd35c6dfd2b7f757cb41deb1a2de84ffe7d90b4f4ded51dada0840c7f65",
    "original": "The Moss-Touched Cairn",
    "translation": "",
    "context": ""
  },
  {
    "key": "23ce4342799ed3bece84cf4884b4b541b6ff0ee1ffded61df81dd69cf5c67b72",
    "original": "The Shaded Hill",
    "translation": "",
    "context": ""
  },
  {
    "key": "00eae3fb6bcecd0a8c11aed0ca9b234c6e2e37599e15d7b2411d751e054c4165",
    "original": "The Thorn-Bound Grave",
    "translation": "",
    "context": ""
  },
  {
    "key": "4a749a56da1c4abde696fd01bd0157169895bd0f15e956c3a775376f9acc8c3d",
    "original": "The Throne Hall",
    "translation": "",
    "context": ""
  },
  {
    "key": "74df343a8be9bd1231fd7fb45f8feb4d52aedb8fc25d33d1b88d9362e3265d18",
    "original": "The Unearthed Place",
    "translation": "",
    "context": ""
  },
  {
    "key": "1e00974a4f759d14d5efdd761d4baf15d38c95ef7eec67c6da6ad14f952f4e9b",
    "original": "The Vault of Kingsunder",
    "translation": "",
    "context": ""
  },
  {
    "key": "d39fdf6ac2e8fe12e872a4dad3dd817b558b8684df6d2445595a27e084faeb38",
    "original": "The Vowkeeper's Vault",
    "translation": "",
    "context": ""
  },
  {
    "key": "668b07aa4cbe178dde95ce0339c6fbb66b4f112764c09aec4e5fe83aff5ca7bf",
    "original": "The War-Sleepers",
    "translation": "",
    "context": ""
  },
  {
    "key": "e3f61de699029401b3119b37b3ef67eb89931f0cdfa802e71c59068288009c77",
    "original": "The Wyrd-King's Fane",
    "translation": "",
    "context": ""
  },
  {
    "key": "53b5916735ff5f3dcb10d24683d5c4eb6ab63a8beba8c3efe881da02f68ed41c",
    "original": "The bones are dressed in gold and furs, same as in life. And they guard it with the same hands, too.",
    "translation": "",
    "context": ""
  },
  {
    "key": "f298ab51a7d8e96ff15fcd2f4dea43a5f8407ec494256f11ed637fde3e260ab6",
    "original": "The dead there weren't buried to rest. They were buried to wait.",
    "translation": "",
    "context": ""
  },
  {
    "key": "fecf4978a11e507aa5f03d306e02306085bf62f79be1cb3d3aa07a128d5c90fb",
    "original": "The grave goods were stolen long ago. Or so the last band of thieves said before they disappeared.",
    "translation": "",
    "context": ""
  },
  {
    "key": "6a16c210bfc4d1f249d93c91c6ebe194fc406065f8372bca47427b76ea0d1676",
    "original": "The place was sealed with a rune-stone none could read. Now the door's open, and something watches from within.",
    "translation": "",
    "context": ""
  },
  {
    "key": "1a45c142508470488867f1ba35ea34d94d53288a93f45f4dd239c4255f266ab4",
    "original": "The walls are carved with stories in stone. Kings, battles, fires. But the last story never ends.",
    "translation": "",
    "context": ""
  },
  {
    "key": "1fa82f7c61f638fa1df2e9f35fd331541e1a706ffe103030f731cdaa60e9721e",
    "original": "The warriors buried there followed their chieftain even into death. Trouble is, they still do.",
    "translation": "",
    "context": ""
  },
  {
    "key": "82ba9c307c7e0312ed3e545fef10114e1edaf4adc03d260f2f2a85ab57fcc336",
    "original": "There's a name above the lintel, worn smooth by time. Might be best it stayed unread.",
    "translation": "",
    "context": ""
  },
  {
    "key": "b234715e0dc900cc2e7d91777288f87bc1a9ec9fca2d753857e2b314c330d3cc",
    "original": "They say it's just a family mound. But if so, it's a loud one.",
    "translation": "",
    "context": ""
  },
  {
    "key": "950bba7743852a218f45983b945e481e204bc0d26a7f236175bffc13564775a7",
    "original": "They say kings lie there with their tribes. All of them with eyes that never close.",
    "translation": "",
    "context": ""
  },
  {
    "key": "4a8db3d3f846efa0bdbfc500b75e50dd18243182308ac4b12afa53880312ed98",
    "original": "Thronewake",
    "translation": "",
    "context": ""
  },
  {
    "key": "0072dd4e399ca9cc2166ed208bfac5d2051af2de473ba439a95d7fcd71dbe4b5",
    "original": "Used to be folks came from leagues around to pay respects. Now even the crows keep their distance.",
    "translation": "",
    "context": ""
  },
  {
    "key": "cf16020710dabac3fb1b6d4c187987a54176106e5edda590bea57906f018d594",
    "original": "Vault of the Lost Reaver",
    "translation": "",
    "context": ""
  },
  {
    "key": "b7bb365a85759187b77f20bfa7151461320eec49a63a19267abfab8430c3f882",
    "original": "Vault of the Silver Helm",
    "translation": "",
    "context": ""
  },
  {
    "key": "03ce832fe40e49df089c8b523ebf6ad5c35e4f9b61182de411432c91a121b759",
    "original": "Vault of the Swordfather",
    "translation": "",
    "context": ""
  },
  {
    "key": "8f884dc77f48941ebf7343a7f0ef0a69f3c1c9ab426a1b6dbffa100695369856",
    "original": "Veiled Barrows",
    "translation": "",
    "context": ""
  },
  {
    "key": "529f3a5183a0bd82ee9cf828cacbf276f4f08bd7549472cd9be931f02676198c",
    "original": "Vigil of the First Sons",
    "translation": "",
    "context": ""
  },
  {
    "key": "826bd6ae5c73cea60039298cc5fe30788fc4d7bcaac6f3e9cf10b5aba726737a",
    "original": "Whisperfen Hollow",
    "translation": "",
    "context": ""
  },
  {
    "key": "8e4482a0e687e13e3caf99c0a9b2c3353cbe3af1d6c7bb5efd1c6966473076e3",
    "original": "Whispering Barrow",
    "translation": "",
    "context": ""
  },
  {
    "key": "4ba320e9046ba718286eab935caccc8a5048c50a7a9e81e2387c7636587879f9",
    "original": "Whispering Stones",
    "translation": "",
    "context": ""
  },
  {
    "key": "aeeecc1d7f7acbb81ac27e02cb9bfd386d236cbedc4a5441b4cf1c8282c5185a",
    "original": "Windgrave",
    "translation": "",
    "context": ""
  },
  {
    "key": "b5692091e7f3994bfa30d7cf93c0e61deeb39837e9af09688474428161cab54f",
    "original": "Wyrdsinger's Tomb",
    "translation": "",
    "context": ""
  },
  {
    "key": "1882dfea96979aa144511ee428c58b5c3f39a70f9fb947611f0a2de46360acaa",
    "original": "Wyrdstone Mound",
    "translation": "",
    "context": ""
  },
  {
    "key": "554267adc1f4e97d9b596d0d00eb3824d4d29bd627debfd1f1c283a27e5f6661",
    "original": "You can still see runes on the walls if you bring a torch. Just don't read them aloud.",
    "translation": "",
    "context": ""
  },
  {
    "key": "9193d67cb0562fab2fe270b7185e1544761020600e461c1f7445e3f3333c251d",
    "original": "You hear music sometimes. Horns and drums, like a feast starting. There's no feast.",
    "translation": "",
    "context": ""
  },
  {
    "key": "369b86cc06feae6c048b9fdb1b5f7f288d15533c5adfef0cf0158b68f9a6b85f",
    "original": "You'll find old coins and maybe a blade or two in the dirt. Just mind what you wake up reaching for them.",
    "translation": "",
    "context": ""
  }
]