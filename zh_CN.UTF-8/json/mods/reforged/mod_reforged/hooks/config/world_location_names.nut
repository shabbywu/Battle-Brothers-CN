    "translation": "缚誓石室",
    "context": "getroottable().Const.World.LocationNames.RF_DraugrCrypt = [\"Crypt of the Oath-Bound\",\"Hall of the Flame-Taker\",\"Grave of the Last Duel\",\"The Fellblade Crypt\",\"Chamber of the Unburned\",\"Rest of the Sable Fang\",\"The Broken Shield Crypt\",\"Vault of the Swordfather\",\"Hero's Hollow\",\"Crypt of Red Valor\",\"Halls of Bitter Triumph\",\"Deepgrave\",\"The War-Sleepers\",\"The Vowkeeper's Vault\",\"Bladewake Crypt\",\"The Thorn-Bound Grave\",\"Vault of the Silver Helm\",\"Stone-Watch of the Dead\",\"Rest of the Storm-Kin\",\"Crypt of the Drowned Banner\",\"Deepwatch Hold\",\"Grave of the Ice-Bitten\",\"Wyrdsinger's Tomb\",\"Crypt of the Raven-Haired\",\"The Fireless Pyre\",\"Oathstone Chamber\",\"Deathwake Hall\",\"Vault of the Lost Reaver\",\"Ironrest Crypt\",\"The Bound Hall\",\"Thane's Rest\",\"Thane's Watch\"]"
