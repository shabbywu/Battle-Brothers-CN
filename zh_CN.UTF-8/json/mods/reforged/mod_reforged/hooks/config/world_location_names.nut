  },
  {
    "key": "c890b87dd43429a986727ebc1720f9efe6e186b59912f97f0cf7c40eb37f8b11",
    "original": "Bladewake Crypt",
    "translation": "",
    "context": ""
  },
  {
    "key": "c8cccd7c0d3313ce2748146634fc5c574b2cc87f0ce075fab3121041baf13718",
    "original": "Built into the mountain itself. Bigger than a lord's hall. But no fires burn within. Just echoes.",
    "translation": "",
    "context": ""
  },
  {
    "key": "c5cac49d4243775587fb64e2072b70693378b110e636bfad17cfccfb5d22cbab",
