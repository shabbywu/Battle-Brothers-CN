  },
  {
    "ID": 1007412414,
    "key": "6614aa0e87ac3e789a4e842eb2a67b2866fec88b40672aaa6e75bfa654e2c7e1",
    "original": "Does not take into account abilities which ignore or modify [Reach|Concept.Reach] during an attack.",
