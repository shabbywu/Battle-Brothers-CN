    "translation": "",
    "context": "\"The [Action Point|Concept.ActionPoints] cost of [$ $|Skill+quick_shot] is reduced by \" + getroottable().MSU.Text.colorPositive(1) + \".\""
  },
  {
    "ID": 1007412699,
    "key": "7da9f4c20fa4c1960a9d3e38c7cff5d68cfbceb8d2b10d58cf54af0fe3c763cc",
