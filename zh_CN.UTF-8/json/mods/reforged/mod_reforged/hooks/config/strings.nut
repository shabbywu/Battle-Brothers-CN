    "key": "2bf16fa0f4bba9e2e5819749c571d51ad44043becc2c4f2655282d922ccbad6a",
    "original": "The effects of [$ $|Skill+bleeding_effect] are ",
    "translation": "",
    "context": "\"The effects of [$ $|Skill+bleeding_effect] are \" + getroottable().MSU.Text.colorPositive(\"halved\") + \".\""
  },
